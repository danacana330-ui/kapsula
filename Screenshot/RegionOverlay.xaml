<Window x:Class="Kapsula.Screenshot.RegionOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="#66000000"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Cursor="Cross" WindowStartupLocation="Manual">
    <Canvas x:Name="Root">
        <Border x:Name="Selection" Visibility="Collapsed" BorderBrush="#FFB86B" BorderThickness="2"
                Background="#22FFB86B">
            <TextBlock x:Name="SizeLabel" Foreground="#FFB86B" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,-22"/>
        </Border>
        <TextBlock Text="Выдели область мышью · Esc — отмена"
                   Foreground="#CCFFFFFF" FontSize="13" Canvas.Left="20" Canvas.Top="20"/>
    </Canvas>
</Window>
