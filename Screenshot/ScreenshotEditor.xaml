<Window x:Class="Kapsula.Screenshot.ScreenshotEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kapsula"
        Title="Снимок экрана" WindowStyle="None" AllowsTransparency="True" Background="#EE101216"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        FontFamily="{x:Static local:Theme.Font}" ShowInTaskbar="True">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,10,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="Color1" Style="{StaticResource IconButton}" Click="OnColor" Tag="#FF7A6B" ToolTip="Красный">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#FF7A6B"/>
                </Button>
                <Button x:Name="Color2" Style="{StaticResource IconButton}" Click="OnColor" Tag="#FFB86B" ToolTip="Оранжевый">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#FFB86B"/>
                </Button>
                <Button x:Name="Color3" Style="{StaticResource IconButton}" Click="OnColor" Tag="#7BE3A8" ToolTip="Зелёный">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#7BE3A8"/>
                </Button>
                <Button x:Name="Color4" Style="{StaticResource IconButton}" Click="OnColor" Tag="#FFFFFF" ToolTip="Белый">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#FFFFFF"/>
                </Button>
                <Button x:Name="Color5" Style="{StaticResource IconButton}" Click="OnColor" Tag="#000000" ToolTip="Чёрный">
                    <Border Width="16" Height="16" CornerRadius="8" Background="#000000"/>
                </Button>

                <Border Width="1" Background="#22FFFFFF" Margin="8,6"/>

                <Button Style="{StaticResource IconButton}" Click="OnThin" ToolTip="Тонкая кисть">
                    <Border Width="16" Height="2" Background="#FFFFFF" CornerRadius="1"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnThick" ToolTip="Толстая кисть">
                    <Border Width="16" Height="6" Background="#FFFFFF" CornerRadius="3"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnUndo" ToolTip="Отменить">
                    <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Click="OnClear" ToolTip="Стереть всё">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="Рисуй мышью прямо по снимку" FontSize="11"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{x:Static local:Theme.DimBrush}"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="FindButton" Style="{StaticResource GhostButton}" Click="OnFindOnline"
                        ToolTip="Найти этот снимок в интернете (Яндекс.Картинки)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Найти в интернете" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Content="Копировать" Click="OnCopy"/>
                <Button Style="{StaticResource GhostButton}" Content="Сохранить" Click="OnSave"/>
                <Button Style="{StaticResource IconButton}" Click="OnClose" ToolTip="Закрыть" Margin="4,0,0,0">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#000000" Margin="12,0" CornerRadius="10" ClipToBounds="True">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="Surface">
                    <Image x:Name="Shot"/>
                    <InkCanvas x:Name="Ink" Background="Transparent"/>
                </Grid>
            </Viewbox>
        </Border>

        <Grid Grid.Row="2" Margin="14,8,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Hint" Grid.Column="0" VerticalAlignment="Center"
                       Text="Ctrl+C — копировать · Ctrl+S — сохранить · Ctrl+F — найти в интернете · Esc — закрыть"
                       TextTrimming="CharacterEllipsis"
                       FontSize="11" Foreground="{x:Static local:Theme.DimBrush}"/>

            <Button x:Name="CopyLinkButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                    Content="Скопировать ссылку" Visibility="Collapsed"
                    Click="OnCopyLink" Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</Window>
