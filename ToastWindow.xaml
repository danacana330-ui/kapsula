<Window x:Class="Kapsula.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kapsula"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" MaxWidth="340"
        FontFamily="{x:Static local:Theme.Font}">
    <Border CornerRadius="16" Background="{x:Static local:Theme.BgBrush}"
            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
            Padding="14,11" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel MinWidth="250">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="Head" Text="Скопировано" FontSize="11" Margin="8,0,0,0"
                           VerticalAlignment="Center" Foreground="{x:Static local:Theme.DimBrush}"/>
            </StackPanel>
            <TextBlock x:Name="Preview" Text="" FontSize="12.5" Margin="0,5,0,0"
                       TextWrapping="Wrap" MaxHeight="54" TextTrimming="CharacterEllipsis"
                       Foreground="{x:Static local:Theme.TextBrush}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="OpenButton" Style="{StaticResource GhostButton}" Content="Открыть"
                        Click="OnOpen" Visibility="Collapsed"/>
                <Button Style="{StaticResource GhostButton}" Content="В заметки"
                        Click="OnToNotes" Margin="6,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
