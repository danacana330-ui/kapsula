<Window x:Class="Kapsula.SummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kapsula"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="True"
        ResizeMode="NoResize" Width="424" SizeToContent="Height" MaxHeight="700"
        FontFamily="{x:Static local:Theme.Font}">
    <Border x:Name="Box" CornerRadius="23" Background="{x:Static local:Theme.BgBrush}"
            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
            Padding="20" Margin="14">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <StackPanel>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Сводка на сегодня" FontSize="16" FontWeight="SemiBold"
                               Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBlock x:Name="DateText" Text="" FontSize="11.5" Margin="0,3,0,0"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnClose"
                        ToolTip="Закрыть" VerticalAlignment="Top">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                </Button>
            </Grid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="470">
                <StackPanel>
                    <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                            Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <local:WeatherIcon x:Name="WeatherGlyph" Kind="cloud" Width="44" Height="44"
                                                   VerticalAlignment="Center"/>
                                <TextBlock x:Name="TempText" Text="—" FontSize="34" FontWeight="Bold"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{x:Static local:Theme.TextBrush}"/>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="DescText" Text="погода" FontSize="12.5"
                                               Foreground="{x:Static local:Theme.TextBrush}"/>
                                    <TextBlock x:Name="RangeText" Text="" FontSize="11.5" Margin="0,3,0,0"
                                               Foreground="{x:Static local:Theme.DimBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="SunText" Text="" FontSize="11.5" Margin="0,10,0,0"
                                       Foreground="{x:Static local:Theme.DimBrush}"/>
                            <TextBlock x:Name="HintText" Text="" FontSize="12" Margin="0,8,0,0"
                                       TextWrapping="Wrap" Foreground="{x:Static local:Theme.AccentBrush}"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                            Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Планы на сегодня" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{x:Static local:Theme.DimBrush}"/>
                            <StackPanel x:Name="PlansPanel"/>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Text="Курсы ЦБ" FontSize="11" Margin="0,0,0,8"
                                       Foreground="{x:Static local:Theme.DimBrush}"/>
                            <StackPanel x:Name="RatesPanel"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Style="{StaticResource GhostButton}" Content="я понял, спасибо"
                    Click="OnClose" HorizontalAlignment="Stretch" Margin="0,14,0,0" Padding="12,9"/>
        </StackPanel>
    </Border>
</Window>
