<UserControl x:Class="Kapsula.Mascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Stage" ClipToBounds="True">
        <Canvas x:Name="Root" Width="40" Height="32"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Ellipse x:Name="Shadow" Canvas.Left="12" Canvas.Top="27" Width="16" Height="3.4" Fill="#33000000"/>

            <Canvas x:Name="BodyGroup">
                <Line X1="20" Y1="8" X2="20" Y2="3.4" Stroke="#1A1A1A" StrokeThickness="1.3"/>
                <Ellipse x:Name="Antenna" Canvas.Left="18" Canvas.Top="0.8" Width="4" Height="4"
                         Fill="#FFB86B" Stroke="#1A1A1A" StrokeThickness="1.1"/>

                <Rectangle Canvas.Left="10" Canvas.Top="7" Width="20" Height="17"
                           RadiusX="8.5" RadiusY="8.5"
                           Fill="#F3EEE6" Stroke="#1A1A1A" StrokeThickness="1.5"/>

                <Rectangle Canvas.Left="12.6" Canvas.Top="11.4" Width="14.8" Height="8.2"
                           RadiusX="4" RadiusY="4" Fill="#262B33"/>

                <Ellipse x:Name="EyeL" Canvas.Left="16.2" Canvas.Top="13.7" Width="2.6" Height="2.6" Fill="#FFB86B"/>
                <Ellipse x:Name="EyeR" Canvas.Left="21.2" Canvas.Top="13.7" Width="2.6" Height="2.6" Fill="#FFB86B"/>

                <Rectangle Canvas.Left="7.6" Canvas.Top="14" Width="2.4" Height="6"
                           RadiusX="1.2" RadiusY="1.2"
                           Fill="#E4DED2" Stroke="#1A1A1A" StrokeThickness="1.1"/>
                <Rectangle Canvas.Left="30" Canvas.Top="14" Width="2.4" Height="6"
                           RadiusX="1.2" RadiusY="1.2"
                           Fill="#E4DED2" Stroke="#1A1A1A" StrokeThickness="1.1"/>

                <Rectangle x:Name="FootL" Canvas.Left="14.5" Canvas.Top="23" Width="4" Height="3.4"
                           RadiusX="1.6" RadiusY="1.6"
                           Fill="#E4DED2" Stroke="#1A1A1A" StrokeThickness="1.1"/>
                <Rectangle x:Name="FootR" Canvas.Left="21.5" Canvas.Top="23" Width="4" Height="3.4"
                           RadiusX="1.6" RadiusY="1.6"
                           Fill="#E4DED2" Stroke="#1A1A1A" StrokeThickness="1.1"/>
            </Canvas>

            <Canvas x:Name="Headphones" Opacity="0">
                <Path Data="M8.6,14.5 Q20,0.6 31.4,14.5" Stroke="#1A1A1A" StrokeThickness="1.7"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Rectangle Canvas.Left="6.2" Canvas.Top="11.4" Width="3.6" Height="7.4"
                           RadiusX="1.8" RadiusY="1.8"
                           Fill="#FFB86B" Stroke="#1A1A1A" StrokeThickness="1.2"/>
                <Rectangle Canvas.Left="30.2" Canvas.Top="11.4" Width="3.6" Height="7.4"
                           RadiusX="1.8" RadiusY="1.8"
                           Fill="#FFB86B" Stroke="#1A1A1A" StrokeThickness="1.2"/>
            </Canvas>
        </Canvas>
    </Grid>
</UserControl>
