<Window x:Class="Kapsula.SummaryStripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kapsula"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        FontFamily="{x:Static local:Theme.Font}">
    <Border x:Name="Box" CornerRadius="16" Background="{x:Static local:Theme.BgBrush}"
            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
            Padding="13,10" Margin="10" Cursor="Hand" MouseLeftButtonUp="OnClick">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="GlyphText" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                       Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="Label" Text="ваша сводка готова" FontSize="12" Margin="8,0,0,0"
                       MaxWidth="120" TextWrapping="Wrap" VerticalAlignment="Center"
                       Foreground="{x:Static local:Theme.TextBrush}"/>
        </StackPanel>
    </Border>
</Window>
