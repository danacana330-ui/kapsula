<UserControl x:Class="Kapsula.Panels.MusicPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE8D6;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Музыка" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Обновить список"
                    Click="OnRescan"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="18">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Text="ничего не играет" FontSize="14" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBlock x:Name="PlaceText" Text="" FontSize="10.5" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,6,0,14"
                               Foreground="{x:Static local:Theme.DimBrush}"/>

                    <ProgressBar x:Name="Bar" Height="5" Maximum="1" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="OnPrevious" ToolTip="Предыдущая">
                            <TextBlock Text="&#xE892;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnPlay" Margin="8,0" ToolTip="Играть">
                            <TextBlock x:Name="PlayGlyph" Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="OnNext" ToolTip="Следующая">
                            <TextBlock Text="&#xE893;" FontFamily="Segoe MDL2 Assets" FontSize="14"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Папка с музыкой" FontSize="11" Margin="0,16,0,6"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <TextBlock x:Name="FolderText" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                </StackPanel>
            </Border>

            <ListBox Grid.Column="1" x:Name="List" Style="{StaticResource PlainList}" Margin="12,0,0,0"
                     SelectionChanged="OnPick"/>
        </Grid>
    </Grid>
</UserControl>
