<UserControl x:Class="Kapsula.Panels.NotesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Заметки" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" x:Name="Counter" FontSize="11" VerticalAlignment="Center"
                       Foreground="{x:Static local:Theme.DimBrush}"/>
        </Grid>

        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <WrapPanel x:Name="FolderBar"/>
            <Grid x:Name="NewFolderRow" Visibility="Collapsed" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderInput" Style="{StaticResource InputBox}" KeyDown="OnFolderKey"
                         Padding="10,6"/>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Создать"
                        Click="OnCreateFolder" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="Input" Style="{StaticResource InputBox}" KeyDown="OnInputKey"
                     TextChanged="OnInputChanged" Tag="Что записать?"/>
            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Записать"
                    Click="OnAdd" Margin="8,0,0,0"/>
        </Grid>

        <!-- напоминание: одна плашка, дальше календарь и время -->
        <Button x:Name="RemindBar" Grid.Row="3" Margin="0,0,0,10" Cursor="Hand" Click="OnAddRemind"
                HorizontalContentAlignment="Left">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="{x:Static local:Theme.CardBrush}"/>
                    <Setter Property="BorderBrush" Value="{x:Static local:Theme.StrokeBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Padding" Value="10,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="12"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{x:Static local:Theme.CardHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7ED;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="RemindHint" Text="Добавить напоминание" FontSize="11.5"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
            </StackPanel>
        </Button>

        <Border x:Name="CalendarHost" Grid.Row="6" Visibility="Collapsed" Margin="0,0,0,10"
                CornerRadius="14" Padding="8,6"
                Background="{x:Static local:Theme.CardBrush}"
                BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButton}" Click="OnPrevMonth" ToolTip="Месяц назад">
                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <TextBlock Grid.Column="1" x:Name="MonthTitle" Text="" FontSize="11.5"
                               FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{x:Static local:Theme.TextBrush}"/>
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnNextMonth" ToolTip="Месяц вперёд">
                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnCancelRemind"
                            Margin="4,0,0,0" ToolTip="Закрыть календарь">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                    </Button>
                </Grid>

                <Grid Grid.Row="1" x:Name="CalendarGrid"/>
            </Grid>
        </Border>

        <Grid x:Name="TimeRow" Grid.Row="6" Visibility="Collapsed" Margin="0,0,0,10"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="TimeHint" Text="Во сколько?" FontSize="11.5" VerticalAlignment="Center"
                       Foreground="{x:Static local:Theme.DimBrush}"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Style="{StaticResource IconButton}" Click="OnTimeEarlier" ToolTip="На полчаса раньше">
                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
                <TextBlock x:Name="RemindTime" Text="18:00" FontSize="13" FontWeight="SemiBold"
                           MinWidth="50" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
                <Button Style="{StaticResource IconButton}" Click="OnTimeLater" ToolTip="На полчаса позже">
                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                </Button>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Напомнить"
                    Margin="10,0,0,0" Click="OnSetRemind"/>
            <Button Grid.Column="3" Style="{StaticResource GhostButton}" Content="Снять"
                    Margin="8,0,0,0" Click="OnClearRemind"/>
            <Button Grid.Column="4" Style="{StaticResource GhostButton}" Content="Отмена"
                    HorizontalAlignment="Right" Click="OnCancelRemind"/>
        </Grid>

        <ListBox Grid.Row="6" x:Name="List" Style="{StaticResource PlainList}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Top" Margin="0,2,10,0" IsChecked="{Binding Done}"
                                  Click="OnToggleDone" Tag="{Binding}"
                                  Foreground="{x:Static local:Theme.AccentBrush}"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                       Foreground="{x:Static local:Theme.TextBrush}"/>
                            <TextBlock Text="{Binding At, StringFormat='{}{0:dd.MM, HH:mm}'}" FontSize="10.5"
                                       Margin="0,3,0,0" Foreground="{x:Static local:Theme.DimBrush}"/>
                            <TextBlock Text="{Binding RemindText}" FontSize="10.5" Margin="0,2,0,0"
                                       Foreground="{x:Static local:Theme.AccentBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="OnDelete"
                                Tag="{Binding}" ToolTip="Удалить">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
