<UserControl x:Class="Kapsula.Panels.SystemPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Компьютер" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="CpuText" Text="—" FontSize="40" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBlock Text="загрузка процессора" FontSize="11" HorizontalAlignment="Center"
                               Margin="0,2,0,14" Foreground="{x:Static local:Theme.DimBrush}"/>
                    <TextBlock x:Name="MemoryText" FontSize="12.5" HorizontalAlignment="Center"
                               Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBlock x:Name="DiskText" FontSize="12.5" HorizontalAlignment="Center"
                               Margin="0,6,0,0" Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBlock x:Name="BatteryText" FontSize="12.5" HorizontalAlignment="Center"
                               Margin="0,6,0,0" Foreground="{x:Static local:Theme.TextBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Процессор" FontSize="11" Margin="2,0,0,6"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <ProgressBar x:Name="CpuBar" Height="6" Maximum="100" Margin="0,0,0,12"/>
                <TextBlock Text="Память" FontSize="11" Margin="2,0,0,6"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <ProgressBar x:Name="MemoryBar" Height="6" Maximum="100" Margin="0,0,0,12"/>
                <TextBlock Text="Диск C:" FontSize="11" Margin="2,0,0,6"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <ProgressBar x:Name="DiskBar" Height="6" Maximum="100" Margin="0,0,0,12"/>
                <TextBlock Text="Батарея" FontSize="11" Margin="2,0,0,6"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <ProgressBar x:Name="BatteryBar" Height="6" Maximum="100"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
