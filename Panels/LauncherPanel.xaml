<UserControl x:Class="Kapsula.Panels.LauncherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <TextBox x:Name="Query" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource InputBox}"
                     TextChanged="OnQueryChanged"
                     KeyDown="OnQueryKey" FontSize="13.5"
                     Tag="Запустить программу, найти файл, посчитать: 12*8"/>
            <TextBlock Grid.Column="2" Text="Alt+Space" FontSize="10.5" VerticalAlignment="Center"
                       Margin="10,0,4,0" Foreground="{x:Static local:Theme.DimBrush}"/>
        </Grid>

        <ListBox Grid.Row="1" x:Name="Results" Style="{StaticResource PlainList}"
                 SelectionChanged="OnSelect" MouseLeftButtonUp="OnClickResult">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12.5"
                                   Foreground="{x:Static local:Theme.TextBrush}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="2" Text="Enter — запустить, Esc — закрыть"
                   FontSize="11" Foreground="{x:Static local:Theme.DimBrush}" Margin="4,8,0,0"/>
    </Grid>
</UserControl>
