<UserControl x:Class="Kapsula.Panels.TimerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Таймер" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="00:00" FontSize="52" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBlock x:Name="StateText" Text="выбери время" FontSize="11.5"
                               HorizontalAlignment="Center" Margin="0,4,0,18"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MinutesBox" Style="{StaticResource InputBox}" Text="5"/>
                        <TextBlock Text="минут" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Grid.Column="1" Foreground="{x:Static local:Theme.DimBrush}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Старт" Click="OnStart"/>
                        <Button Style="{StaticResource GhostButton}" Content="Стоп" Click="OnStop" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="Быстрый выбор" FontSize="11" Margin="2,0,0,8"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <UniformGrid Columns="2" Rows="2">
                    <Button Style="{StaticResource Tile}" Margin="0,0,6,6" Tag="1" Click="OnPreset">
                        <TextBlock Text="1 минута" FontSize="12.5"/>
                    </Button>
                    <Button Style="{StaticResource Tile}" Margin="6,0,0,6" Tag="5" Click="OnPreset">
                        <TextBlock Text="5 минут" FontSize="12.5"/>
                    </Button>
                    <Button Style="{StaticResource Tile}" Margin="0,6,6,0" Tag="15" Click="OnPreset">
                        <TextBlock Text="15 минут" FontSize="12.5"/>
                    </Button>
                    <Button Style="{StaticResource Tile}" Margin="6,6,0,0" Tag="25" Click="OnPreset">
                        <TextBlock Text="25 минут" FontSize="12.5"/>
                    </Button>
                </UniformGrid>

                <TextBlock Text="Идут сейчас" FontSize="11" Margin="2,14,0,6"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ActiveList"/>
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
