<UserControl x:Class="Kapsula.Panels.QuickPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Быстрые действия" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Обновить" Click="OnRefresh"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Columns="3" Rows="1">
                <Button x:Name="WifiTile" Style="{StaticResource Tile}" Margin="0,0,4,0" Click="OnWifi">
                    <StackPanel>
                        <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="{x:Static local:Theme.AccentBrush}"/>
                        <TextBlock Text="Wi-Fi" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="WifiState" Text="…" FontSize="11"
                                   Foreground="{x:Static local:Theme.DimBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="BtTile" Style="{StaticResource Tile}" Margin="4,0,4,0" Click="OnBluetooth">
                    <StackPanel>
                        <TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="{x:Static local:Theme.AccentBrush}"/>
                        <TextBlock Text="Bluetooth" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="BtState" Text="…" FontSize="11"
                                   Foreground="{x:Static local:Theme.DimBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ThemeTile" Style="{StaticResource Tile}" Margin="4,0,0,0" Click="OnTheme">
                    <StackPanel>
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                   Foreground="{x:Static local:Theme.AccentBrush}"/>
                        <TextBlock Text="Тема Windows" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock x:Name="ThemeState" Text="…" FontSize="11"
                                   Foreground="{x:Static local:Theme.DimBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- звук и яркость -->
            <Border Grid.Row="1" CornerRadius="14" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                    Padding="12,8" Margin="0,12,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Height="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Click="OnMute" ToolTip="Выключить звук">
                            <TextBlock x:Name="SoundIcon" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        </Button>
                        <Grid Grid.Column="1" x:Name="SoundTrack" Height="24" Margin="8,0"
                              Tag="sound" Background="Transparent" MouseLeftButtonDown="OnSliderDown"
                              MouseMove="OnSliderMove" MouseLeftButtonUp="OnSliderUp" Cursor="Hand">
                            <Border Height="6" CornerRadius="3" Background="#1FFFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="SoundFill" Height="6" CornerRadius="3" Width="100"
                                    Background="{x:Static local:Theme.AccentGradient}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="SoundState" Text="…" FontSize="11.5" Width="34"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.DimBrush}"/>
                    </Grid>

                    <Grid Grid.Row="1" Height="26" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                   Width="28" TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.AccentBrush}"/>
                        <Grid Grid.Column="1" x:Name="LightTrack" Height="24" Margin="8,0"
                              Tag="light" Background="Transparent" MouseLeftButtonDown="OnSliderDown"
                              MouseMove="OnSliderMove" MouseLeftButtonUp="OnSliderUp" Cursor="Hand">
                            <Border Height="6" CornerRadius="3" Background="#1FFFFFFF" VerticalAlignment="Center"/>
                            <Border x:Name="LightFill" Height="6" CornerRadius="3" Width="100"
                                    Background="{x:Static local:Theme.AccentGradient}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Grid.Column="2" x:Name="LightState" Text="…" FontSize="11.5" Width="34"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.DimBrush}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" CornerRadius="14" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                    Padding="14,10" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="DownloadsText" Text="Загрузки" FontSize="12"
                               Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{x:Static local:Theme.TextBrush}"/>
                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Открыть" Click="OnOpenDownloads"/>
                </Grid>
            </Border>

            <Border Grid.Row="3" CornerRadius="14" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                    Padding="10,8" Margin="0,10,0,0">
                <UniformGrid Columns="4">
                    <Button x:Name="LockBtn" Style="{StaticResource GhostButton}" Tag="lock"
                            Content="Блокировка" Click="OnPower"/>
                    <Button x:Name="SleepBtn" Style="{StaticResource GhostButton}" Tag="sleep"
                            Content="Сон" Click="OnPower"/>
                    <Button x:Name="RebootBtn" Style="{StaticResource GhostButton}" Tag="reboot"
                            Content="Перезагрузка" Click="OnPower"/>
                    <Button x:Name="ShutdownBtn" Style="{StaticResource GhostButton}" Tag="shutdown"
                            Content="Выключение" Click="OnPower"/>
                </UniformGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
