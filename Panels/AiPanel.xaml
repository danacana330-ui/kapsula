<UserControl x:Class="Kapsula.Panels.AiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ИИ" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
                <TextBlock x:Name="HintText" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Новый чат" Click="OnNewChat"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="16" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Модели" FontSize="11"
                               Foreground="{x:Static local:Theme.DimBrush}" Margin="2,0,0,8"/>

                    <ListBox Grid.Row="1" x:Name="ModelsList" Style="{StaticResource PlainList}"
                             SelectionChanged="OnModelPicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12"
                                               Foreground="{x:Static local:Theme.TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{x:Static local:Theme.DimBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="AdviceText" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{x:Static local:Theme.DimBrush}" Margin="2,0,2,8"/>
                        <Button x:Name="MiniActionBtn" Style="{StaticResource GhostButton}" Content="Скачать"
                                Click="OnMiniAction" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <ProgressBar x:Name="PullBar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                     Foreground="{x:Static local:Theme.AccentBrush}" Background="#1AFFFFFF"
                                     BorderThickness="0" Visibility="Collapsed"/>
                        <TextBlock x:Name="PullStatus" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{x:Static local:Theme.DimBrush}"/>
                        <StackPanel x:Name="OllamaPullBlock" Margin="0,8,0,0">
                            <TextBox x:Name="PullBox" Style="{StaticResource InputBox}" FontSize="11.5"/>
                            <Button Style="{StaticResource GhostButton}" Content="Скачать в Ollama" Click="OnPull"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Expander x:Name="ServerBox" Header="Свой сервер" Margin="0,10,0,0"
                                  Foreground="{x:Static local:Theme.DimBrush}" FontSize="11">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Адрес (…/v1)" FontSize="10" Margin="2,0,0,3"
                                           Foreground="{x:Static local:Theme.DimBrush}"/>
                                <TextBox x:Name="ServerUrl" Style="{StaticResource InputBox}" FontSize="11"/>
                                <TextBlock Text="Ключ" FontSize="10" Margin="2,6,0,3"
                                           Foreground="{x:Static local:Theme.DimBrush}"/>
                                <TextBox x:Name="ServerKey" Style="{StaticResource InputBox}" FontSize="11"/>
                                <TextBlock Text="Модель" FontSize="10" Margin="2,6,0,3"
                                           Foreground="{x:Static local:Theme.DimBrush}"/>
                                <TextBox x:Name="ServerModel" Style="{StaticResource InputBox}" FontSize="11"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="ServerSaveBtn" Style="{StaticResource GhostButton}"
                                            Content="Сохранить" Click="OnServerSave" Padding="8,3"/>
                                    <Button x:Name="ServerTestBtn" Style="{StaticResource GhostButton}"
                                            Content="Проверить" Click="OnServerTest" Padding="8,3" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="ServerStatus" FontSize="10" TextWrapping="Wrap" Margin="2,6,0,0"
                                           Foreground="{x:Static local:Theme.DimBrush}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="OllamaBanner" Visibility="Collapsed" CornerRadius="12"
                        Background="#14FFB86B" BorderBrush="#33FFB86B" BorderThickness="1"
                        Padding="10,7" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="На компьютере есть Ollama — можно отвечать на её моделях"
                                   FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.TextBrush}"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Перейти"
                                Click="OnOllamaSwitch" Margin="8,0,0,0" Padding="8,3"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="14" Padding="12,9" Margin="0,0,0,8"
                                        MaxWidth="460" HorizontalAlignment="{Binding Align}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Копировать ответ" Click="OnCopyBubble"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="#33FFB86B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                                   Foreground="{x:Static local:Theme.TextBrush}"/>
                                        <TextBlock Text="{Binding Meta}" FontSize="9.5" Margin="0,4,0,0"
                                                   Foreground="{x:Static local:Theme.DimBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Input" Style="{StaticResource InputBox}" MinHeight="42" MaxHeight="96"
                             AcceptsReturn="True" TextWrapping="Wrap" KeyDown="OnInputKey"
                             VerticalContentAlignment="Center"
                             Tag="Спроси что-нибудь — отвечает локальная модель"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0"
                                VerticalAlignment="Center">
                        <Button x:Name="RegenBtn" Style="{StaticResource GhostButton}" Content="Заново"
                                Click="OnRegenerate" Margin="0,0,6,0"/>
                        <Button x:Name="StopBtn" Style="{StaticResource GhostButton}" Content="Стоп"
                                Click="OnStop" Margin="0,0,6,0" Visibility="Collapsed"/>
                        <Button x:Name="SendBtn" Style="{StaticResource GhostButton}" Content="Отправить"
                                Click="OnSend"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
