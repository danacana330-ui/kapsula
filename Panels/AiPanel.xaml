<UserControl x:Class="Kapsula.Panels.AiPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="ИИ" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
                <TextBlock x:Name="HintText" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Новый чат" Click="OnNewChat"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="16" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Модели на компьютере" FontSize="11"
                               Foreground="{x:Static local:Theme.DimBrush}" Margin="2,0,0,8"/>

                    <ListBox Grid.Row="1" x:Name="ModelsList" Style="{StaticResource PlainList}"
                             SelectionChanged="OnModelPicked">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12"
                                               Foreground="{x:Static local:Theme.TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SizeText}" FontSize="10"
                                               Foreground="{x:Static local:Theme.DimBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <TextBlock x:Name="AdviceText" FontSize="10.5" TextWrapping="Wrap"
                                   Foreground="{x:Static local:Theme.DimBrush}" Margin="2,0,2,8"/>
                        <TextBox x:Name="PullBox" Style="{StaticResource InputBox}" FontSize="11.5"/>
                        <Button Style="{StaticResource GhostButton}" Content="Скачать модель" Click="OnPull"
                                HorizontalAlignment="Left" Margin="0,6,0,0"/>
                        <ProgressBar x:Name="PullBar" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                     Foreground="{x:Static local:Theme.AccentBrush}" Background="#1AFFFFFF"
                                     BorderThickness="0" Visibility="Collapsed"/>
                        <TextBlock x:Name="PullStatus" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{x:Static local:Theme.DimBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ChatList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="14" Padding="12,9" Margin="0,0,0,8"
                                        MaxWidth="460" HorizontalAlignment="{Binding Align}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#14FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                    <Setter Property="Background" Value="#33FFB86B"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5"
                                               Foreground="{x:Static local:Theme.TextBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="Input" Style="{StaticResource InputBox}" Height="42"
                                 AcceptsReturn="True" TextWrapping="Wrap" KeyDown="OnInputKey"
                                 VerticalContentAlignment="Center"/>
                        <TextBlock Text="Спроси что-нибудь — отвечает локальная модель" IsHitTestVisible="False"
                                   Margin="13,0,0,0" VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{x:Static local:Theme.DimBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=Input}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Отправить"
                            Click="OnSend" Margin="8,0,0,0"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
