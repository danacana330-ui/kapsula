<UserControl x:Class="Kapsula.Panels.WeatherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <local:WeatherIcon Kind="partly" Width="16" Height="16" VerticalAlignment="Center"/>
                <TextBlock Text="Погода" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Обновить" Click="OnRefresh"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <TextBox x:Name="CityBox" Style="{StaticResource InputBox}" KeyDown="OnCityKey"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <local:WeatherIcon x:Name="BigIcon" Kind="cloud" Width="52" Height="52"
                                           VerticalAlignment="Center"/>
                        <TextBlock x:Name="TempText" FontSize="52" FontWeight="Bold" Margin="14,0,0,0"
                                   Foreground="{x:Static local:Theme.TextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="DescText" FontSize="13" Margin="0,6,0,0"
                               Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBlock x:Name="FeelsText" FontSize="11.5" Margin="0,4,0,0"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <TextBlock x:Name="StatusText" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <ItemsControl x:Name="DaysList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Background="{x:Static local:Theme.CardBrush}"
                                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
                                    Padding="16,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Day}" FontSize="12.5"
                                               Foreground="{x:Static local:Theme.TextBrush}"/>
                                    <local:WeatherIcon Grid.Column="1" Kind="{Binding Kind}"
                                                       Width="18" Height="18" Margin="0,0,12,0"
                                                       VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Range}" FontSize="12.5"
                                               Foreground="{x:Static local:Theme.DimBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
