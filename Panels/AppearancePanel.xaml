<UserControl x:Class="Kapsula.Panels.AppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Kapsula"
             FontFamily="{x:Static local:Theme.Font}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButton}" Click="OnBack" ToolTip="Назад">
                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="13"/>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Вид и поведение" FontSize="15" FontWeight="SemiBold" Margin="8,0,0,0"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border CornerRadius="18" Background="{x:Static local:Theme.CardBrush}"
                    BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="18">
                <StackPanel>
                    <TextBlock Text="Что показывать на главной" FontSize="11" Margin="0,0,0,10"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="TilesPanel"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="История буфера" FontSize="11" Margin="2,0,0,8"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CleanupBox" Style="{StaticResource InputBox}" TextAlignment="Center"
                             ToolTip="Через сколько часов вычищать историю; 0 — не чистить"/>
                    <TextBlock Text="часов, 0 — не чистить" FontSize="11" VerticalAlignment="Center"
                               Margin="10,0,0,0" Grid.Column="1" Foreground="{x:Static local:Theme.DimBrush}"/>
                </Grid>

                <TextBlock Text="Утренняя сводка" FontSize="11" Margin="2,0,0,8"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <CheckBox x:Name="SummaryBox" Content="Показывать" VerticalAlignment="Center"
                              Foreground="{x:Static local:Theme.TextBrush}"/>
                    <TextBox x:Name="SummaryTimeBox" Style="{StaticResource InputBox}" Width="72"
                             Margin="12,0,0,0" TextAlignment="Center" ToolTip="Время вида 09:00"/>
                </StackPanel>

                <CheckBox x:Name="LightBox" Content="Светлая тема" Margin="0,0,0,10"
                          Foreground="{x:Static local:Theme.TextBrush}"/>
                <CheckBox x:Name="CursorBox" Content="Маскот следит за курсором" Margin="0,0,0,10"
                          Foreground="{x:Static local:Theme.TextBrush}"/>
                <CheckBox x:Name="MotionBox" Content="Меньше анимации" Margin="0,0,0,10"
                          Foreground="{x:Static local:Theme.TextBrush}"/>
                <CheckBox x:Name="FullscreenBox" Content="Прятать в полноэкранных видео и играх"
                          Margin="0,0,0,16" Foreground="{x:Static local:Theme.TextBrush}"/>

                <Button Style="{StaticResource GhostButton}" Content="Открыть все настройки"
                        HorizontalAlignment="Left" Click="OnAllSettings"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
