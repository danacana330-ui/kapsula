<Window x:Class="Kapsula.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kapsula"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        FontFamily="{x:Static local:Theme.Font}" Title="Знакомство с Kapsula">
    <Border CornerRadius="18" Background="{x:Static local:Theme.BgBrush}"
            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1"
            Padding="22,18" Margin="14" Width="430">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="Kapsula" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{x:Static local:Theme.DimBrush}"/>
                <TextBlock x:Name="StepText" Text="1 из 3" FontSize="11" Margin="12,0,0,0"
                           VerticalAlignment="Center" Foreground="{x:Static local:Theme.DimBrush}"/>
            </StackPanel>

            <TextBlock x:Name="TitleText" Text="Капсула живёт наверху экрана" FontSize="17"
                       FontWeight="SemiBold" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{x:Static local:Theme.TextBrush}"/>

            <TextBlock x:Name="BodyText" Text="" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                       LineHeight="19" Foreground="{x:Static local:Theme.DimBrush}"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GhostButton}" Content="Пропустить" Click="OnSkip"
                        HorizontalAlignment="Left"/>
                <Button x:Name="NextBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                        Content="Дальше" Click="OnNext"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
