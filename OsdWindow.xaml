<Window x:Class="Kapsula.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kapsula"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" Width="240" Height="64"
        FontFamily="{x:Static local:Theme.Font}">
    <Border x:Name="Box" CornerRadius="18" Background="{x:Static local:Theme.BgBrush}"
            BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1" Padding="14,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock x:Name="Glyph" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Foreground="{x:Static local:Theme.AccentBrush}" VerticalAlignment="Center"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="Caption" Text="" FontSize="11" Foreground="{x:Static local:Theme.DimBrush}"/>
                <TextBlock x:Name="Value" Text="" FontSize="14" FontWeight="SemiBold"
                           Foreground="{x:Static local:Theme.TextBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
