<Window x:Class="Kapsula.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kapsula"
        Title="Настройки Kapsula" Width="470" Height="680"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Static local:Theme.BgBrush}"
        WindowStartupLocation="CenterScreen" FontFamily="{x:Static local:Theme.Font}"
        ResizeMode="NoResize" ShowInTaskbar="True" Topmost="True">
    <Border CornerRadius="18" BorderBrush="{x:Static local:Theme.StrokeBrush}" BorderThickness="1">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold"
                           Foreground="{x:Static local:Theme.TextBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="OnClose" ToolTip="Закрыть">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <CheckBox x:Name="AutostartBox" Content="Запускать вместе с Windows"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,6"/>
                    <Button Style="{StaticResource GhostButton}" Content="Создать ярлык на рабочем столе"
                            Click="OnMakeShortcut" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                    <TextBlock Text="Сводка дня" FontSize="11" Margin="0,4,0,6"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <CheckBox x:Name="SummaryBox" Content="Показывать утреннюю сводку"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Во сколько" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.TextBrush}"/>
                        <TextBox x:Name="SummaryTimeBox" Grid.Column="1" Width="86" Margin="12,0,0,0"
                                 Style="{StaticResource InputBox}" Padding="10,6" Tag="09:00"/>
                    </Grid>

                    <CheckBox x:Name="HoverBox" Content="Раскрывать при наведении"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="SecondsBox" Content="Показывать секунды на часах"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="OsdBox" Content="Показывать громкость и CapsLock на экране"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,18"/>

                    <TextBlock Text="Внешний вид" FontSize="11" Margin="0,0,0,8"
                               Foreground="{x:Static local:Theme.DimBrush}"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Размер острова" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.TextBrush}"/>
                        <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="100" Maximum="199"
                                SmallChange="1" LargeChange="10" Value="100" Margin="12,0"
                                VerticalAlignment="Center"/>
                        <TextBlock x:Name="ScaleValue" Grid.Column="2" Text="100 %" FontSize="12"
                                   MinWidth="44" TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.DimBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Шрифт" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{x:Static local:Theme.TextBrush}"/>
                        <ComboBox x:Name="FontBox" Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                                  VerticalContentAlignment="Center"/>
                    </Grid>

                    <CheckBox x:Name="LightBox" Content="Светлая тема острова"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="RimBox" Content="Светлая кромка"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ShadowBox" Content="Тень под капсулой"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="MotionBox" Content="Меньше анимации"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="CursorBox" Content="Маскот следит за курсором"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="PrivacyBox" Content="Точки микрофона и камеры"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="FullscreenBox" Content="Прятать в полноэкранных видео и играх"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="ToastBox" Content="Уведомление при копировании"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,18"/>

                    <TextBlock Text="Что показывать на главной" FontSize="11" Margin="0,0,0,8"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <WrapPanel x:Name="TilesPanel" Margin="0,0,0,16"/>

                    <TextBlock Text="Город для погоды" FontSize="11" Margin="0,0,0,6"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <TextBox x:Name="CityBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

                    <TextBlock Text="Адрес Ollama" FontSize="11" Margin="0,0,0,6"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <TextBox x:Name="AiBox" Style="{StaticResource InputBox}" Margin="0,0,0,14"/>

                    <CheckBox x:Name="RecAudioBox" Content="Записывать звук системы"
                              Foreground="{x:Static local:Theme.TextBrush}" Margin="0,0,0,10"/>

                    <TextBlock Text="Папка для записей экрана" FontSize="11" Margin="0,0,0,6"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RecBox" Style="{StaticResource InputBox}"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Выбрать"
                                Click="OnPickFolder" Margin="8,0,0,0"/>
                    </Grid>

                    <TextBlock Text="Горячие клавиши" FontSize="11" Margin="0,6,0,6"
                               Foreground="{x:Static local:Theme.DimBrush}"/>
                    <TextBlock Text="Alt+Space — запуск программ и поиск&#10;Alt+S или Ctrl+Shift+S — скриншот области&#10;Alt+R или Ctrl+Shift+R — запись экрана&#10;Ctrl+F в окне снимка — найти в интернете"
                               FontSize="11.5" LineHeight="20"
                               Foreground="{x:Static local:Theme.TextBrush}"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Отмена" Click="OnClose"/>
                <Button Style="{StaticResource GhostButton}" Content="Сохранить" Click="OnSave" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
